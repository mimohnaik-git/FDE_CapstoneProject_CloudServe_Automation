{
    "title":  "CloudServe Support Automation",
    "schemaVersion":  38,
    "panels":  [
                   {
                       "type":  "stat",
                       "title":  "Tickets processed (last 1h)",
                       "targets":  [
                                       {
                                           "expr":  "round(sum(increase(cloudserve_decisions_total{run_mode=~\"$run_mode\"}[1h]))) or vector(0)"
                                       }
                                   ],
                       "gridPos":  {
                                       "x":  0,
                                       "y":  0,
                                       "w":  12,
                                       "h":  6
                                   }
                   },
                   {
                       "type":  "stat",
                       "title":  "Total AUTO_RESPOND decisions",
                       "targets":  [
                                       {
                                           "expr":  "sum(cloudserve_decisions_total{route=\"AUTO_RESPOND\",run_mode=~\"$run_mode\"}) or vector(0)"
                                       }
                                   ],
                       "gridPos":  {
                                       "x":  12,
                                       "y":  0,
                                       "w":  12,
                                       "h":  6
                                   }
                   },
                   {
                       "type":  "timeseries",
                       "title":  "Decisions by route",
                       "targets":  [
                                       {
                                           "expr":  "sum by (route) (rate(cloudserve_decisions_total{run_mode=~\"$run_mode\"}[5m]))"
                                       }
                                   ],
                       "gridPos":  {
                                       "x":  0,
                                       "y":  6,
                                       "w":  12,
                                       "h":  8
                                   }
                   },
                   {
                       "type":  "timeseries",
                       "title":  "Pipeline P95 latency (s)",
                       "targets":  [
                                       {
                                           "expr":  "histogram_quantile(0.95, sum by (le) (rate(cloudserve_pipeline_seconds_bucket{run_mode=~\"$run_mode\"}[5m])))"
                                       }
                                   ],
                       "gridPos":  {
                                       "x":  12,
                                       "y":  6,
                                       "w":  12,
                                       "h":  8
                                   }
                   },
                   {
                       "type":  "timeseries",
                       "title":  "Guardrail blocks",
                       "targets":  [
                                       {
                                           "expr":  "sum by (guardrail) (rate(cloudserve_guardrail_blocks_total{run_mode=~\"$run_mode\"}[5m]))"
                                       }
                                   ],
                       "gridPos":  {
                                       "x":  0,
                                       "y":  14,
                                       "w":  12,
                                       "h":  8
                                   }
                   },
                   {
                       "type":  "timeseries",
                       "title":  "Handled failures",
                       "targets":  [
                                       {
                                           "expr":  "sum by (kind) (rate(cloudserve_failures_total{run_mode=~\"$run_mode\"}[5m]))"
                                       }
                                   ],
                       "gridPos":  {
                                       "x":  12,
                                       "y":  14,
                                       "w":  12,
                                       "h":  8
                                   }
                   }
               ],
    "templating":  {
                       "list":  [
                                    {
                                        "name":  "run_mode",
                                        "label":  "Run mode",
                                        "type":  "custom",
                                        "query":  "demo,evaluator",
                                        "current":  {
                                                        "text":  "All",
                                                        "value":  ".*"
                                                    },
                                        "includeAll":  true,
                                        "allValue":  ".*"
                                    }
                                ]
                   },
    "tags":  [
                 "cloudserve",
                 "live-verification"
             ]
}