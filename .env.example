# Safe default: automatic customer release is disabled.
#
# ENABLED=true requests automatic customer release.
# DISABLE=true explicitly disables it and overrides ENABLED.
CLOUDSERVE_AUTO_RESPONSE_ENABLED=false
CLOUDSERVE_AUTO_RESPONSE_DISABLE=true

# Optional path overrides.
# Relative paths assume the repository root.
CLOUDSERVE_KB=data/cloudserve/documentation.json
CLOUDSERVE_ARTIFACTS=artifacts
CLOUDSERVE_DB=var/decisions.sqlite3

# No external model-provider credential is required for the
# deterministic submitted release.
# If a custom provider adapter is added, keep its credential
# only in a local environment and never commit it.
