RETRIEVAL_ROUTING_THRESHOLD=0.30
RETRIEVAL_TOP_K=5

# Operational API security.
# Generate a strong random value before enabling /tickets/process.
SUPPORT_API_KEY=
SUPPORT_API_RATE_LIMIT_PER_MINUTE=60
