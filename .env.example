OPENROUTER_API_KEY=
MODEL_NAME=openrouter/free
OPENROUTER_MODEL_NAME=openrouter/free
GENERATION_PROVIDER=offline
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

GROQ_API_KEY=
GROQ_MODEL_NAME=openai/gpt-oss-20b
